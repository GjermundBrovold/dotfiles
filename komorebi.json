// Launch command command 
// $ komorebic start --whkd --bar --masir
{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/master/schema.json",

  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",

  "mouse_follows_focus": false,

  "default_workspace_padding": 0,
  "default_container_padding": -1,
  "border": true,
  "border_width": 2,
  "border_offset": -1,


  "monitors": [
    // monitor 1, index 0
    {
      "workspaces": [
        {
          "name": "1",
          "layout": "Columns"
        },
        {
          "name": "2",
          "layout": "Columns"
        },
        {
          "name": "3",
          "layout": "Columns"
        },
        {
          "name": "4",
          "layout": "Columns"
        },
        {
          "name": "5",
          "layout": "Columns"
        },
        {
          "name": "6",
          "layout": "Columns"
        },
        {
          "name": "7",
          "layout": "Columns"
        },
        {
          "name": "8",
          "layout": "Columns"
        },
        {
          "name": "9",
          "layout": "Columns"
        },
        {
          "name": "10",
          "layout": "Columns"
        }
      ]
    },
    // monitor 2, index 1
    {
      "workspaces": [
        { "name": "2",
          "layout": "Columns"
        }
      ]
    }
  ]
}
